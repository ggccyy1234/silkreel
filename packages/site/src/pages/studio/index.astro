---
import Base from '../../layouts/Base.astro'
import { PALETTES } from '@silk-reel/choreo'
import { aspects, boards, formats, inks } from '../../data/site'
import '../../styles/studio.css'

const frameIcon = (id: string, size = 22) => {
  const [w, h] = id.split(':').map(Number) as [number, number]
  const k = size / Math.max(w, h)
  return `width:${(w * k).toFixed(1)}px;height:${(h * k).toFixed(1)}px`
}
const looks = [
  { id: 'trace', name: 'Trace', text: 'The lit board' },
  { id: 'glyph', name: 'Glyph', text: 'Parts set as type' }
] as const
---
<Base title="Studio" description="Drop a KiCad board and watch its release film play in your browser. Change the look, then record it or copy the command." image="/og.png">
  <div class="st" data-studio data-mode="empty">
    <h1 class="sr-only">Studio</h1>
    <p class="sr-only" role="status" data-status></p>

    <section class="st__stage-col pos" aria-label="Film preview">
      <div class="st__src">
        <input class="sr-only" type="file" accept=".kicad_pcb" tabindex="-1" aria-hidden="true" data-file />
        <button type="button" class="st__drop" data-pick>
          <span class="st__drop-t">Drop your <span class="mono">.kicad_pcb</span></span>
          <span class="st__drop-s">or choose a file</span>
        </button>
        <p class="st__priv">It opens in this tab. Nothing is uploaded.</p>
        <p class="st__err" role="alert" data-err hidden></p>
        <button type="button" class="btn st__own" data-pick>Use your own board</button>
        <div class="st__sample">
          <label class="st__or" for="st-sample">or try a sample</label>
          <span class="st__select">
            <select id="st-sample" data-sample>
              <option value="" disabled hidden>Choose a sample</option>
              {boards.map((b) => <option value={b.id}>{b.name}</option>)}
            </select>
          </span>
        </div>
      </div>

      <div class="st__film" data-film>
        <div class="st__monitor" data-monitor>
          <i class="st__perf st__perf--l" aria-hidden="true"></i><i class="st__perf st__perf--r" aria-hidden="true"></i>
          <div class="st__stage" data-stage>
            <canvas data-out role="img" aria-label="Preview of the film"></canvas>
            <p class="st__busy" data-busy hidden aria-hidden="true"><span class="st__spin"></span><span data-busy-say>Reading your board…</span></p>
          </div>
        </div>
        <div class="st__transport">
          <button type="button" class="st__play" data-play aria-label="Pause" aria-pressed="true">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path class="st__ico-pause" d="M4 3h3v10H4zM9 3h3v10H9z" /><path class="st__ico-play" d="M4 2.5v11l9.5-5.5z" /></svg>
          </button>
          <div class="st__track" data-track role="slider" tabindex="0" aria-label="Playhead" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0">
            <i class="st__fill" data-fill aria-hidden="true"></i>
            <i class="st__head" data-head aria-hidden="true"></i>
          </div>
          <span class="st__tc"><b data-tc>00:00.00</b> / <span data-dur>00:00.00</span></span>
        </div>
      </div>
    </section>

    <div class="st__panel">
      <fieldset class="st__g">
        <legend>Look</legend>
        <div class="st__looks">
          {looks.map((l, i) => (
            <label class="st__look"><input type="radio" name="style" value={l.id} checked={i === 0} /><span class="st__look-n">{l.name}</span><span class="st__look-t">{l.text}</span></label>
          ))}
        </div>
        <p class="st__note" data-live-note hidden>Your board plays as glyph here. Trace renders from the command line.</p>
        <div class="st__inks" role="radiogroup" aria-label="Palette" data-only="glyph">
          {inks.map((k, i) => (
            <label class="st__ink" title={k.text}><input type="radio" name="palette" value={k.id} checked={i === 0} /><i style={`--sw:${PALETTES[k.id].silk};--sw-bg:${PALETTES[k.id].bg}`} aria-hidden="true"></i><span class="sr-only">{k.id}</span></label>
          ))}
          <span class="st__ink-n" data-palette-name aria-hidden="true">Mono</span>
        </div>
      </fieldset>

      <fieldset class="st__g">
        <legend>Frame</legend>
        <div class="st__aspects">
          {aspects.map((a) => (
            <label class="st__aspect"><input type="radio" name="aspect" value={a.id} checked={a.id === '16:9'} /><i style={frameIcon(a.id)} aria-hidden="true"></i><span class="mono">{a.id}</span></label>
          ))}
        </div>
        <p class="st__use" data-aspect-use>Launch pages, YouTube, talks</p>
      </fieldset>

      <fieldset class="st__g">
        <legend>Title card</legend>
        <div class="st__pair">
          <label class="st__field"><span>Name</span><input type="text" name="title" maxlength="32" placeholder="iCEBreaker" autocomplete="off" spellcheck="false" data-title /></label>
          <label class="st__field"><span>Version</span><input type="text" name="version" maxlength="12" placeholder="v1.0e" autocomplete="off" spellcheck="false" /></label>
        </div>
      </fieldset>

      <details class="st__adv">
        <summary>Advanced</summary>
        <div class="st__adv-in">
          <label class="st__range"><span>Tempo</span><input type="range" name="tempo" min="0.75" max="1.5" step="0.05" value="1" /><output class="mono" data-out-for="tempo">1.00×</output></label>
          <label class="st__range" data-only="glyph"><span>Density</span><input type="range" name="density" min="0.5" max="1.5" step="0.05" value="1" /><output class="mono" data-out-for="density">1.00</output></label>
          <div class="st__row">
            <label class="st__field st__field--seed"><span>Seed</span><input type="number" name="seed" value="42" min="0" max="99999" inputmode="numeric" /></label>
            <button type="button" class="st__dice" data-dice aria-label="New random seed"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2" width="12" height="12" rx="2" /><circle cx="5.5" cy="5.5" r="1" /><circle cx="10.5" cy="10.5" r="1" /><circle cx="8" cy="8" r="1" /></svg></button>
          </div>
          <div class="st__row">
            <label class="st__field st__field--accent"><span>Accent</span><input type="color" name="accent" value="#ff4a3d" /></label>
            <span class="mono st__accent-v" data-accent-v>Default</span>
            <button type="button" class="st__link" data-accent-reset hidden>Reset</button>
          </div>
        </div>
      </details>

      <fieldset class="st__g st__cmd">
        <legend>Command line</legend>
        <div class="st__chips" role="radiogroup" aria-label="Format">
          {formats.map((f, i) => (
            <label class="st__chip" title={f.use}><input type="radio" name="format" value={f.id} checked={i === 0} /><span>{f.name.split(' ')[0]}</span></label>
          ))}
        </div>
        <div class="term"><p class="term__body st__cmd-body" data-cmd tabindex="0">npm run reel -- icebreaker.kicad_pcb</p></div>
        <div class="st__btns">
          <button type="button" class="btn" data-copy-cmd><span data-roll>Copy command</span></button>
          <div class="st__render" data-render-box hidden>
            <button type="button" class="btn" data-render><span data-roll data-render-label>Render</span></button>
          </div>
        </div>
        <ol class="st__jobs" data-jobs aria-live="polite"></ol>
      </fieldset>

      <div class="st__actions">
        <button type="button" class="btn btn--solid st__rec" data-record disabled><span data-record-label>Record WebM</span></button>
        <button type="button" class="btn" data-still disabled>Save still</button>
      </div>
    </div>

    <p class="st__toast" data-toast aria-hidden="true"></p>
  </div>
</Base>

<script>
  import { setupStudio } from '../../studio/studio'
  setupStudio()
</script>
