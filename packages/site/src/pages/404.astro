---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
import '../styles/docs.css'
---
<Base title="Not found" image="/og-404.png" description="There is no page at this address. Go back to the film or read the docs." noindex>
  <section class="lost">
    <div class="lost__say">
      <h1 class="xl">This page never powered on.</h1>
      <p class="lede">There is no page at this address.</p>
      <div class="lost__actions">
        <a class="btn btn--solid" href="/">Back to the film</a>
        <a class="btn" href="/docs/">Read the docs</a>
      </div>
    </div>
    <div class="lost__frame" aria-hidden="true">
      <canvas class="lost__film" data-lost></canvas>
    </div>
  </section>
  <Footer slot="footer" />
</Base>

<script>
  import { World } from '../world/world'
  import { fixtureFilm } from '../world/films'
  import { prefersReducedMotion } from '../engine/env'
  import { ROOM } from '../world/room'

  const canvas = document.querySelector<HTMLCanvasElement>('[data-lost]')
  if (canvas) {
    const reduced = prefersReducedMotion()
    const world = new World(canvas, { reduced })
    world.setPalette(ROOM, { instant: true })
    world.setView({ rect: null, zoom: 1.6, cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5 }, { instant: true })
    void fixtureFilm('video', '16:9').then((film) => {
      world.show(film, { decode: false })
      world.reveal()
      world.scrub(film.tl.totalFrames * 0.66)
      canvas.dataset.on = ''
    })
  }
</script>
