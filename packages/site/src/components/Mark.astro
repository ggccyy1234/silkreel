---
// The silk reel mark: three rails, three posts, three rings. Each stroke is its own unit so the loader can decode it in.
interface Props { class?: string; decode?: boolean }
const { class: cls, decode = false } = Astro.props
---
<svg class:list={['mark', cls]} viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
  <path data-unit={decode ? 0 : undefined} d="M17 20h30" />
  <path data-unit={decode ? 1 : undefined} d="M17 32h30" />
  <path data-unit={decode ? 2 : undefined} d="M17 44h30" />
  <path data-unit={decode ? 3 : undefined} d="M24 14v12" />
  <path data-unit={decode ? 4 : undefined} d="M40 26v12" />
  <path data-unit={decode ? 5 : undefined} d="M24 38v12" />
  <circle data-unit={decode ? 6 : undefined} cx="24" cy="20" r="4" fill="var(--mark-fill, var(--c-bg))" />
  <circle data-ring={decode ? '' : undefined} cx="40" cy="32" r="4" fill="var(--mark-fill, var(--c-bg))" />
  <circle data-unit={decode ? 7 : undefined} cx="24" cy="44" r="4" fill="var(--mark-fill, var(--c-bg))" />
</svg>
