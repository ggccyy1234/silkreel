---
import Mark from './Mark.astro'
const path = Astro.url.pathname
const home = path === '/'
const links = [
  { href: '/#film', id: 'film', label: 'Film' },
  { href: '/studio/', id: 'studio', label: 'Studio' },
  { href: '/docs/', id: 'docs', label: 'Docs' }
]
---
<header class="hd" data-header>
  <a class="hd__brand" href="/" aria-label="silk reel, home">
    <Mark class="hd__mark" decode />
    <span class="hd__word">silk reel</span>
  </a>
  <nav class="hd__nav" aria-label="Main">
    {links.map((l) => (
      <a href={home && l.id === 'film' ? '#film' : l.href} data-nav={l.id} aria-current={(l.id === 'docs' && path.startsWith('/docs')) || (l.id === 'studio' && path.startsWith('/studio')) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <div class="hd__end">
    {path.startsWith('/studio')
      ? <a class="btn btn--solid hd__cta" href="/docs/#install">Get the CLI</a>
      : <a class="btn btn--solid hd__cta" href="/studio/">Open studio</a>}
  </div>
</header>
<style>
  .hd {
    position: fixed; inset: 0 0 auto 0; z-index: var(--z-header);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    padding: 14px var(--gutter);
    color: var(--c-ink);
    view-transition-name: header;
    transition: color var(--t2) var(--soft);
  }
  /* over a length of stock the header turns to light on black */
  :global(html.hd-pos) .hd { --c-ink: var(--opal); --c-bg: var(--stock); --c-muted: #a9a9a3; --c-red: #ff4a3d; --ink-rgb: var(--opal-rgb); --bg-rgb: var(--stock-rgb); --c-line-2: rgb(var(--ink-rgb) / 0.3); }
  .hd::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: var(--c-bg); box-shadow: 0 1px 0 transparent; transition: box-shadow var(--t3) var(--soft), background-color var(--t2) var(--soft);
  }
  :global(html.scrolled) .hd::before { box-shadow: 0 1px 0 var(--c-line); }
  .hd__brand { display: inline-flex; align-items: center; gap: 10px; justify-self: start; height: 44px; padding-inline: 4px; margin-inline: -4px; }
  .hd :global(.hd__mark) { width: 22px; height: 22px; flex: none; --mark-fill: var(--c-bg); transition: rotate var(--t3) var(--soft); }
  .hd__brand:hover :global(.hd__mark) { rotate: -90deg; }
  .hd__word { font-weight: 600; font-size: 1.0625rem; letter-spacing: -0.02em; white-space: nowrap; }

  .hd__nav { display: flex; gap: 4px; }
  .hd__nav a {
    position: relative; display: inline-flex; align-items: center; height: 44px; padding: 0 12px;
    font-size: 0.9375rem; font-weight: 500; color: var(--c-muted); transition: color var(--t2) var(--soft);
  }
  .hd__nav a::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 8px; height: 2px; border-radius: 1px; background: var(--c-red); scale: 0 1; transform-origin: 0 50%; transition: scale var(--t3) var(--soft); }
  .hd__nav a:hover, .hd__nav a[aria-current] { color: var(--c-ink); }
  .hd__nav a[aria-current]::after { scale: 1 1; }
  .hd__nav a:focus-visible { outline: 2px solid var(--c-ink); outline-offset: -6px; color: var(--c-ink); }

  .hd__end { justify-self: end; display: flex; align-items: center; }
  .hd__cta { --h: 38px; padding: 0 14px; font-size: 0.875rem; }

  /* a phone: the name, the three links; the Studio link does the call to action's job */
  @media (max-width: 760px) {
    .hd { grid-template-columns: auto 1fr; gap: 0; padding-block: 8px; }
    .hd__brand :global(.hd__mark) { display: none; }
    .hd__nav { justify-self: end; gap: 0; }
    .hd__nav a { padding: 0 10px; }
    .hd__nav a::after { left: 10px; right: 10px; }
    .hd__end { display: none; }
  }
</style>
