{
  "name": "silk-reel",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint packages",
    "render:canonical": "npm run render:canonical --workspace=@silk-reel/render-api",
    "metrics:gate": "tsx packages/metrics/src/cli.ts fixtures/canonical.mp4",
    "frame-sheet": "node scripts/frame-sheet.mjs",
    "test:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.515",
    "@remotion/cli": "4.0.515",
    "@remotion/player": "4.0.515",
    "@remotion/renderer": "4.0.515",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@tracespace/parser": "^5.0.0-alpha.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.35.0",
    "happy-dom": "^20.11.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
