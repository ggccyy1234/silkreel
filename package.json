{
  "name": "silk-reel",
  "description": "KiCad board in, release film out: renders a .kicad_pcb as a lit product film or a typographic loop.",
  "keywords": [
    "kicad",
    "pcb",
    "electronics",
    "video",
    "motion-graphics",
    "remotion",
    "webgl2"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggccyy1234/silkreel.git"
  },
  "bugs": "https://github.com/ggccyy1234/silkreel/issues",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cad": "tsx packages/cad/src/cli.ts",
    "cad:setup": "tsx packages/cad/src/setup.ts",
    "cad:jlc": "tsx packages/cad/src/jlc3d-cli.ts",
    "cad:doctor": "tsx packages/cad/src/doctor.ts",
    "cad:bootstrap": "tsx packages/cad/src/bootstrap.ts",
    "cad:package": "tsx packages/cad/src/package-release.ts",
    "cad:stages": "tsx packages/cad/src/manufacturing-review.ts",
    "cad:smoke": "tsx packages/cad/src/smoke.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint packages",
    "render:canonical": "npm run render:canonical --workspace=@silk-reel/render-api",
    "metrics:gate": "tsx packages/metrics/src/cli.ts fixtures/canonical.mp4",
    "frame-sheet": "node scripts/frame-sheet.mjs",
    "review": "tsx scripts/review.ts",
    "reel": "tsx packages/cli/src/cli.ts",
    "test:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.515",
    "@remotion/renderer": "4.0.515",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.183.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.35.0",
    "happy-dom": "^20.11.6",
    "playwright": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
